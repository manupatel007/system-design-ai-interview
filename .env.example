VOICE_STT_BACKEND=faster-whisper
VOICE_STT_MODEL=base.en
VOICE_VAD_BACKEND=silero
VOICE_LLM_BACKEND=mock
VOICE_LLM_TIMEOUT_SECONDS=30
VOICE_LLM_MAX_RETRIES=2
VOICE_LLM_STREAMING=false
VOICE_TTS_BACKEND=kokoro
VOICE_TTS_VOICE=af_heart
VOICE_TTS_LANGUAGE=en-us
VOICE_TTS_SPEED=1.0
VOICE_HOST=127.0.0.1
VOICE_PORT=8000

# Only required when VOICE_LLM_BACKEND=databricks.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_MODEL=databricks-gpt-5-6-sol

# Only required when VOICE_LLM_BACKEND=azure_foundry.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-4.1-mini
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
